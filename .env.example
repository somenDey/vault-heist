# Copy this file to .env and fill in your own values:
#     Copy-Item .env.example .env      (PowerShell)
#     cp .env.example .env             (macOS / Linux)
# .env is git-ignored. NEVER put a real key in this file.
# Secrets are left empty here; non-secret settings show safe defaults.

# ---- App ----
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# console (readable, for development) or json (one JSON object per line)
LOG_FORMAT=console

# ---- LLM ----
# Model in LiteLLM format: <provider>/<model>. Changing model is a .env change only.
# Examples: anthropic/claude-haiku-4-5-20251001, ollama_chat/granite4.2:8b
LLM_MODEL=anthropic/claude-haiku-4-5-20251001
# Randomness: 0 = most predictable. Higher = more varied.
LLM_TEMPERATURE=0.7
# Maximum length of one reply, in tokens. Caps the cost of each call.
LLM_MAX_TOKENS=400
LLM_TIMEOUT_SECONDS=30

# Only the key for the provider you use needs a value.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Local models via Ollama (optional, free).
OLLAMA_API_BASE=http://localhost:11434

# ---- Database ----
DATABASE_URL=sqlite:///./vault_heist.db

# ---- Cost protection ----
MAX_MESSAGE_CHARS=500
MAX_MESSAGES_PER_ATTEMPT=30
MAX_MESSAGES_PER_SESSION_PER_DAY=200
