# Shared editor settings. Most editors apply these automatically
# (VS Code and Cursor need the EditorConfig extension).
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[justfile]
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown, so keep them.
trim_trailing_whitespace = false
