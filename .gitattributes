# Store every text file with LF line endings, on every OS.
# This keeps Windows (CRLF) and Linux CI (LF) in agreement, whatever
# each developer's personal core.autocrlf setting is.
* text=auto eol=lf

# Windows-only scripts need CRLF to run correctly.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch line endings, never diff as text.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.db     binary
*.sqlite binary
